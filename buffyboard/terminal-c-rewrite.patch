+    /* Shrink the row count proportionally to the terminal area left over
+     * when the keyboard is on screen (the column count already reflects
+     * the font width, so it is left untouched). */
+    int new_rows = max_rows * _tty_size / _v_display_size;
+    if (new_rows < 1)
+        new_rows = 1;
+
+    size.ws_row = new_rows;
+    if (ioctl(fd, TIOCSWINSZ, &size) == 0)
+        _last_set_rows = new_rows;
 end:
     close(fd);
