 static int32_t _tty_size;
 static int32_t _h_display_size;
 static int32_t _v_display_size;
+static int _last_set_rows = -1;
+
+
+/**
+ * Static prototypes
+ */
+
+/**
+ * Grow the console to its maximum row count and return it. KDFONTOP-based
+ * font metrics are not used because GET is broken on some kernels (it
+ * returns ENOSPC for fonts taller than 32 pixels), so the maximum is
+ * determined by test-resizing instead.
+ *
+ * @param fd TTY file descriptor
+ * @param size pointer to the terminal's current size (updated in place)
+ * @return the maximum row count, or -1 on failure
+ */
+static int grow_to_max_rows(int fd, struct winsize *size);
+
+
+/**
+ * Static functions
+ */
+
+static int grow_to_max_rows(int fd, struct winsize *size) {
+    struct winsize probe = *size;
+
+    /* Test-resize by two rows. If the console is already maximised this
+     * fails with EINVAL and we can exit early without changing anything. */
+    probe.ws_row = size->ws_row + 2;
+    if (ioctl(fd, TIOCSWINSZ, &probe) != 0)
+        return size->ws_row;
+
+    /* Not at max: keep growing in steps of two until it fails. */
+    do {
+        size->ws_row = probe.ws_row;
+        probe.ws_row += 2;
+    } while (probe.ws_row < 1000 && ioctl(fd, TIOCSWINSZ, &probe) == 0);
+
+    return size->ws_row;
+}
 
 
