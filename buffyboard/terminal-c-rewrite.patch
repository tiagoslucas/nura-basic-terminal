+    /* Nothing to do if the console still has the row count we last set */
+    if (_last_set_rows > 0 && size.ws_row == _last_set_rows)
+        goto end;
+
+    int max_rows = grow_to_max_rows(fd, &size);
+    if (max_rows < 1)
+        goto end;
