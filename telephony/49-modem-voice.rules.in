// Allow the device user to control voice calls via ModemManager
// (messaging is already allowed by the distro defaults; voice is not).
// @USER@ is replaced with the device user by install-telephony.sh.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.ModemManager1.Voice" &&
        subject.user == "@USER@") {
        return polkit.Result.YES;
    }
});
