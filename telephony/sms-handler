#!/usr/bin/python3
"""Run a command for every SMS this modem receives.

The command comes from /etc/phone-sms-handler.conf (COMMAND=<shell
command>, re-read before every scan so edits apply without a restart)
and runs with SMS_NUMBER, SMS_TEXT, SMS_TIMESTAMP and SMS_FILE in its
environment. SMS_FILE is a volatile JSON copy of the message under
/tmp/sms/, named uniquely by its content — the network redelivering the
same message (retry storms after a long outage are common) collapses to
one file instead of many copies.

Exit 0 means handled: the SMS is then deleted from modem storage, so
nothing is stored on the phone across reboots. Any other outcome leaves
it in the modem inbox, which doubles as the retry queue — a failing
command delays a message instead of losing it.
"""

import hashlib
import json
import os
import re
import subprocess
import time

CONFIG = "/etc/phone-sms-handler.conf"  # COMMAND=<shell command> (see there)
TMP_DIR = "/tmp/sms"
SCAN_INTERVAL = 15  # seconds


def log(msg):
    print(time.strftime("[%Y-%m-%d %H:%M:%S]"), msg, flush=True)


def read_command():
    """COMMAND from the config file, or None. Commented-out lines with
    examples are ignored, like in phone-sms.conf."""
    try:
        for line in open(CONFIG):
            key, sep, val = line.split("#", 1)[0].partition("=")
            if sep and key.strip() == "COMMAND" and val.strip():
                return val.strip()
    except OSError:
        pass
    return None


def list_received():
    """[(dbus_path, number, text, timestamp)] for received SMS."""
    r = subprocess.run(["mmcli", "-m", "any", "--messaging-list-sms", "-J"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        return []
    out = []
    for path in json.loads(r.stdout or "{}").get("modem.messaging.sms", []):
        d = subprocess.run(["mmcli", "-s", path, "-J"],
                           capture_output=True, text=True)
        if d.returncode != 0:
            continue
        sms = json.loads(d.stdout)["sms"]
        props, content = sms["properties"], sms["content"]
        if props.get("state") != "received":
            continue
        out.append((path, content.get("number") or "unknown",
                    content.get("text") or "", props.get("timestamp") or ""))
    return out


def filename_for(number, text, timestamp):
    """sms-<timestamp>-<number>-<hash>.json — the hash covers the content,
    so identical redeliveries map to one file."""
    ts = re.sub(r"\D", "", timestamp) or time.strftime("%Y%m%d%H%M%S")
    digest = hashlib.md5(f"{number}|{text}|{timestamp}".encode()).hexdigest()[:8]
    return f"sms-{ts}-{re.sub(r'\D', '', number) or 'unknown'}-{digest}.json"


def write_message(number, text, timestamp):
    """Write the message's JSON copy; None if an identical one is already
    there (a redelivery — treated as handled, nothing new to do)."""
    os.makedirs(TMP_DIR, exist_ok=True)
    path = os.path.join(TMP_DIR, filename_for(number, text, timestamp))
    if os.path.exists(path):
        return None
    with open(path, "w", encoding="utf-8") as f:
        json.dump({"timestamp": timestamp, "number": number, "text": text},
                  f, ensure_ascii=False, indent=1)
    return path


def run_command(command, number, text, timestamp, path):
    env = dict(os.environ)
    # sms-send and other user tools live in ~/.local/bin, which user
    # units don't have on PATH
    env["PATH"] = env.get("PATH", "/usr/bin") + ":" + \
        os.path.expanduser("~/.local/bin")
    env.update(SMS_NUMBER=number, SMS_TEXT=text,
               SMS_TIMESTAMP=timestamp, SMS_FILE=path)
    r = subprocess.run(["sh", "-c", command], env=env,
                       capture_output=True, text=True)
    if r.returncode != 0:
        log(f"command failed (rc={r.returncode}): "
            f"{(r.stderr or r.stdout).strip()[:200]}")
    return r.returncode == 0


def handle(command, number, text, timestamp):
    """Run the configured command for one message; True when the message
    is dealt with (command succeeded, or it was a duplicate delivery)."""
    path = write_message(number, text, timestamp)
    if path is None:
        log(f"message from {number} is a duplicate delivery, "
            "not running the command again")
        return True
    return run_command(command, number, text, timestamp, path)


def delete_sms(path):
    r = subprocess.run(["mmcli", "-m", "any", "--messaging-delete-sms=" + path],
                       capture_output=True, text=True)
    return r.returncode == 0


def main():
    log(f"running COMMAND from {CONFIG} for each received SMS")
    warned = False  # complain about a missing COMMAND once, not per scan
    while True:
        try:
            command = read_command()
            if not command:
                if not warned:
                    log(f"no COMMAND in {CONFIG} — messages stay in the "
                        "modem inbox until one is configured")
                    warned = True
            else:
                warned = False
                for path, number, text, timestamp in list_received():
                    if handle(command, number, text, timestamp):
                        if not delete_sms(path):
                            log(f"{path}: handled but could not delete "
                                "from modem")
                    # on failure: leave in inbox, retried next scan
        except Exception as e:
            log(f"scan failed: {e}")
        time.sleep(SCAN_INTERVAL)


if __name__ == "__main__":
    main()
