#!/bin/sh
# Step the console font size up/down. Run as root by hkdm on
# KEY_VOLUMEUP / KEY_VOLUMEDOWN release.
# Ladder: 16, 20, 24, 28, 32, 48 px tall (ter-148n is a 3x scaled
# ter-116n, generated by scale-psf.py). Default index 5 = 48px.
STATE_DIR=/run/phone-buttons
CF=/usr/share/consolefonts
FONTS="ter-116n ter-120n ter-124n ter-128n ter-132n ter-148n"
HEIGHTS="16 20 24 28 32 48"
MAX=5

mkdir -p "$STATE_DIR"
[ -f "$STATE_DIR/font-index" ] || echo $MAX > "$STATE_DIR/font-index"
idx=$(cat "$STATE_DIR/font-index")

case "$1" in
    up)
        idx=$((idx + 1))
        ;;
    down)
        # The ttyescape combo (hold vol-down, tap power) ends with a
        # vol-down release; don't shrink the font right after power use.
        if [ -f "$STATE_DIR/power-recent" ] && \
           [ $(( $(date +%s) - $(stat -c %Y "$STATE_DIR/power-recent") )) -lt 2 ]; then
            exit 0
        fi
        idx=$((idx - 1))
        ;;
    *)
        echo "usage: $0 up|down" >&2
        exit 1
        ;;
esac

[ $idx -lt 0 ] && idx=0
[ $idx -gt $MAX ] && idx=$MAX
echo $idx > "$STATE_DIR/font-index"
echo $(echo $HEIGHTS | cut -d' ' -f$((idx + 1))) > "$STATE_DIR/font-px"

font="$CF/$(echo $FONTS | cut -d' ' -f$((idx + 1))).psf.gz"
for t in /dev/tty1 /dev/tty2; do
    [ -c "$t" ] && setfont -C "$t" "$font" 2>/dev/null
done
