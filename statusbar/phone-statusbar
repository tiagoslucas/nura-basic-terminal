#!/usr/bin/python3
"""Status bar drawn over the top of the fbcon: cellular (left) + battery and
wall clock (right).

Paints only the top band of /dev/fb0 — the region occupied by the display
notch — and never touches the terminal below it. The bar is a FIXED 96px
tall with fixed-size text, independent of the console font, so it never
moves or resizes when the terminal font changes. To save battery the band
is repainted only once per minute, just after the wall-clock minute flips
(the clock is the fastest-changing value shown), and once immediately
when the screen turns on: phone-screen-toggle SIGUSR1s this daemon after
restoring the backlight, and the signal interrupts its sleep. Cellular
tech/signal (mmcli — the expensive fetch, it wakes ModemManager) is
cached for MODEM_EVERY seconds; battery is a cheap sysfs read done per
repaint. A repaint whose text is unchanged skips the framebuffer write.
While the screen is dark the daemon blocks on its wake pipe and costs
nothing: the backlight has a single writer (phone-screen-toggle) which
SIGUSR1s this daemon whenever it lights the screen again. Each repaint
also repairs any console text that scrolled underneath it. Nothing is
drawn within 5px of the left/right screen edges.

--text mode: instead of painting the framebuffer, print the same status
line ("4G 67%          87% 14:05") as plain text on stdout, for sway's
built-in bar (status_command) inside graphical sessions — the fbcon
can't be seen behind a compositor. Battery behaviour matches the console
daemon: it wakes once per minute (the clock is the fastest-changing
value), blocks on SIGUSR1 while the screen is dark, and call-watcher /
phone-screen-toggle poke it directly (the systemd service they'd signal
is stopped during a session). The line is padded to a fixed width so
the cellular half sits at the left edge of the bar and battery/clock at
the right — swaybar right-aligns an unpadded line, which puts the
cellular info behind the display notch.
"""
import glob
import gzip
import os
import select
import signal
import struct
import subprocess
import sys
import time

FB = "/dev/fb0"
SYSFB = "/sys/class/graphics/fb0"
FONTS = "/usr/share/consolefonts"
BACKLIGHT = "/sys/class/backlight/backlight/brightness"
BATTERY = "/sys/class/power_supply/qcom-battery"
BAR_FONT = f"{FONTS}/ter-148n.psf.gz"  # 24x48, fixed regardless of console font
BAR_H = 96                            # fixed: covers the 70px notch, 2 rows at 48px
EDGE_MARGIN = 5                       # px unused at each screen edge
TEXT_MARGIN = 16                      # px between screen edge and indicator text
CONFIG = "/etc/phone-statusbar.conf"  # optional KEY=value overrides
CALL_STATE = "/tmp/phone-call-state"  # "<state> <number>" from call-watcher
# notify-led's unread flags, in the device user's state dir (this daemon
# runs as root on the console, where ~ would be /root)
NOTIFY_DIR = (glob.glob("/home/*/.local/state/notify-led") + [""])[0]


def load_config(path):
    """Parse KEY=int lines from the config file (comments with #).
    Missing file or malformed values fall back to the built-in defaults."""
    cfg = {}
    try:
        lines = open(path).read().splitlines()
    except OSError:
        return cfg
    for line in lines:
        line = line.split("#", 1)[0].strip()
        key, sep, val = line.partition("=")
        if not sep or not key.strip():
            continue
        try:
            cfg[key.strip()] = int(val.strip())
        except ValueError:
            pass
    return cfg


_cfg = load_config(CONFIG)

# Battery-tunable timing (seconds); see phone-statusbar.conf. Raising it
# saves battery at the cost of a staler signal display.
MODEM_EVERY = _cfg.get("MODEM_EVERY", 300)   # how long a mmcli result is cached
TEXT_LEFT = 22    # --text: columns for the cellular/call half
TEXT_RIGHT = 14   # --text: columns for the battery/clock half
# 36 columns fills the bar: "monospace 12" renders at 12 pt = 16 logical
# px (Droid Sans Mono, 0.6 em advance = 9.6 px/char), and the bar is
# 360 logical px wide — 36 × 9.6 = 346, clear of both edges.

TECH_LABEL = {
    "lte": "4G", "nr": "5G", "nr5g": "5G",
    "umts": "3G", "hsdpa": "3G", "hsupa": "3G", "hspa": "3G", "hspa+": "3G",
    "wcdma": "3G", "evdo": "3G",
    "gsm": "2G", "gprs": "2G", "edge": "2G",
}

WHITE = (255, 255, 255)
GREEN = (0, 230, 0)
RED = (255, 60, 60)
GRAY = (70, 70, 70)


class Font:
    """PSF1/PSF2 console font loader (bitmap glyphs + unicode map)."""

    def __init__(self, glyphs, cmap, width, height):
        self.glyphs, self.cmap = glyphs, cmap
        self.width, self.height = width, height
        self.rowbytes = (width + 7) // 8

    @classmethod
    def load(cls, path):
        raw = gzip.open(path, "rb").read() if path.endswith(".gz") \
            else open(path, "rb").read()
        if raw[:2] == b"\x36\x04":
            return cls._load_psf1(raw)
        if raw[:4] == b"\x72\xb5\x4a\x86":
            return cls._load_psf2(raw)
        raise ValueError(f"not a PSF font: {path}")

    @classmethod
    def _load_psf1(cls, raw):
        mode, charsize = raw[2], raw[3]
        n = 512 if mode & 1 else 256
        glyphs = [raw[4 + i * charsize: 4 + (i + 1) * charsize] for i in range(n)]
        cmap = {}
        if mode & 2:
            off, gi, vals = 4 + n * charsize, 0, []
            while gi < n and off + 1 < len(raw):
                (v,) = struct.unpack("<H", raw[off:off + 2])  # Terminus: LE
                off += 2
                if v == 0xFFFF:
                    for c in vals:
                        cmap.setdefault(c, gi)
                    vals, gi = [], gi + 1
                elif v == 0xFFFE:
                    vals = []          # sequence: keep first char only
                elif v >= 0xD800:
                    pass               # surrogate halves: not needed here
                else:
                    vals.append(v)
        return cls(glyphs, cmap, 8, charsize)

    @classmethod
    def _load_psf2(cls, raw):
        _, hdr, flags, length, charsize, height, width = \
            struct.unpack("<7I", raw[4:32])
        glyphs = [raw[hdr + i * charsize: hdr + (i + 1) * charsize]
                  for i in range(length)]
        cmap = {}
        if flags & 1:
            off, gi, vals, pend = hdr + length * charsize, 0, [], b""
            while gi < length and off < len(raw):
                b = raw[off]
                off += 1
                if b == 0xFF:
                    for c in vals:
                        cmap.setdefault(c, gi)
                    vals, gi, pend = [], gi + 1, b""
                elif b == 0xFE:
                    vals, pend = [], b""
                else:
                    pend += bytes([b])
                    try:
                        vals.append(ord(pend.decode("utf-8")))
                        pend = b""
                    except UnicodeDecodeError:
                        pass
        return cls(glyphs, cmap, width, height)


def render_text(font, buf, rowbytes, text, x, y, rgb):
    px = struct.pack("<I", (rgb[0] << 16) | (rgb[1] << 8) | rgb[2])
    for ch in text:
        gi = font.cmap.get(ord(ch), font.cmap.get(ord("?"), 0))
        g = font.glyphs[gi]
        for gy in range(font.height):
            row = g[gy * font.rowbytes:(gy + 1) * font.rowbytes]
            base = (y + gy) * rowbytes + x * 4
            for gx in range(font.width):
                if (row[gx // 8] >> (7 - gx % 8)) & 1:
                    p = base + gx * 4
                    buf[p:p + 4] = px
        x += font.width


def build_band(font, w, left, left_rgb, right, right_rgb):
    rowbytes = w * 4
    buf = bytearray(BAR_H * rowbytes)  # black background
    ty = (BAR_H - font.height) // 2
    render_text(font, buf, rowbytes, left, TEXT_MARGIN, ty, left_rgb)
    rx = w - TEXT_MARGIN - len(right) * font.width
    render_text(font, buf, rowbytes, right, rx, ty, right_rgb)
    # separator line under the bar, clear of the screen edges
    line = struct.pack("<I", (GRAY[0] << 16) | (GRAY[1] << 8) | GRAY[2]) \
        * (w - 2 * EDGE_MARGIN)
    for y in (BAR_H - 2, BAR_H - 1):
        buf[y * rowbytes + EDGE_MARGIN * 4:
            (y + 1) * rowbytes - EDGE_MARGIN * 4] = line
    return buf


def paint(fb, buf, stride, w):
    rb = w * 4
    for y in range(len(buf) // rb):
        fb.seek(y * stride)
        fb.write(buf[y * rb:(y + 1) * rb])


def read_battery():
    try:
        cap = int(open(f"{BATTERY}/capacity").read().strip())
        status = open(f"{BATTERY}/status").read().strip()
        # The pmi8994 fuel gauge's status word is wrong on this port
        # (claims Charging while discharging); the current sign isn't.
        try:
            current = int(open(f"{BATTERY}/current_now").read().strip())
        except (OSError, ValueError):
            current = 0
        if status == "Charging" and current <= 0:
            status = "Discharging"
        return cap, status
    except (OSError, ValueError):
        return None, ""


def read_call_state():
    """Return ("ringing"|"active"|None, number) from the call-watcher."""
    try:
        parts = open(CALL_STATE).read().split(None, 1)
        if parts and parts[0] in ("ringing", "active"):
            return parts[0], (parts[1].strip() if len(parts) > 1 else "?")
    except OSError:
        pass
    return None, ""


def read_modem():
    try:
        out = subprocess.run(["mmcli", "-m", "any", "-K"],
                             capture_output=True, text=True,
                             timeout=8).stdout
    except Exception:
        return None, None
    tech = sig = None
    for line in out.splitlines():
        key, _, val = line.partition(":")
        key, val = key.strip(), val.strip()
        if key.endswith("access-technologies.value[1]"):
            tech = val
        elif key.endswith("signal-quality.value"):
            try:
                sig = int(val)
            except ValueError:
                pass
    return tech, sig


def backlight_on():
    try:
        return int(open(BACKLIGHT).read().strip()) > 0
    except (OSError, ValueError):
        return True


def status_parts(net):
    """(left, left_rgb, right, right_rgb) for right now — the formatting
    shared by the fbcon bar and --text mode. `net` is the cached modem
    result (tech, sig)."""
    tech, sig = net
    if tech:
        label = TECH_LABEL.get(tech, tech.upper())
        left = f"{label} {sig}%" if sig is not None else label
        lrgb = WHITE if (sig is None or sig >= 15) else RED
    else:
        left, lrgb = "NO NET", RED

    # incoming/ongoing call indicator (on the console, call-watcher
    # pokes the daemon with SIGUSR1 on every transition, so this shows
    # up the moment the phone starts ringing)
    cstate, cnum = read_call_state()
    if cstate == "ringing":
        left, lrgb = f"RING {cnum} {left}", GREEN
    elif cstate == "active":
        left = f"CALL {cnum} {left}"

    cap, status = read_battery()
    if cap is None:
        right, rrgb = "?BAT", RED
    elif status == "Charging":
        right, rrgb = f"CHG {cap}%", GREEN
    else:
        right = f"{cap}%"
        rrgb = RED if cap <= 15 else WHITE

    # clock beside the battery, e.g. "87% 14:05"
    right += time.strftime(" %H:%M")

    # unread notifications (flags kept by the notify-led daemon; the LED
    # blinks for the same events) — shown beside the network info, but
    # hidden during a call: RING/CALL take the whole column budget
    notes = [] if cstate in ("ringing", "active") else [
        n for n, flag in (("SMS", "sms"), ("MISS", "missed"))
        if NOTIFY_DIR and os.path.exists(os.path.join(NOTIFY_DIR, flag))]
    if notes:
        left = f"{left} {' '.join(notes)}"
        lrgb = GREEN
    return left, lrgb, right, rrgb


def _noop(_signum, _frame):
    pass  # for SIGUSR1: the wakeup-fd byte matters, not the handler


def text_mode():
    """Plain-text status line for sway's bar (status_command), e.g.
    "4G 67%                    87% 14:05". Same data and formatting as
    the fbcon bar, and the same battery discipline: one wake per
    wall-clock minute (the clock is the fastest-changing value) and no
    polling at all while the screen is dark — it blocks on its SIGUSR1
    wake pipe. call-watcher pokes it on every call transition (so a ring
    shows immediately) and phone-screen-toggle's pkill fallback pokes it
    when the screen lights up again. The line is padded to TEXT_LEFT +
    TEXT_RIGHT columns so the cellular half sits at the left edge of the
    bar and battery/clock at the right, clear of the notch (swaybar
    right-aligns an unpadded line, which parks the cellular info behind
    the notch; a line wider than the bar is clipped from the left, so
    the column count is deliberately a little under what fits)."""
    # Wake pipe: SIGUSR1 drops a byte here via set_wakeup_fd, which
    # interrupts the select() below (same mechanism as the console bar).
    r, wfd = os.pipe()
    os.set_blocking(wfd, False)
    signal.set_wakeup_fd(wfd)
    signal.signal(signal.SIGUSR1, _noop)

    net = (None, None)
    net_age = 0.0
    last_line = None
    while True:
        now = time.time()
        if now - net_age >= MODEM_EVERY:
            net = read_modem()
            net_age = now
        left, _lrgb, right, _rrgb = status_parts(net)
        # a long RING line must not push the battery/clock off-screen
        left = left[:TEXT_LEFT]
        line = f"{left:<{TEXT_LEFT}}{right:>{TEXT_RIGHT}}"
        if line != last_line:
            print(line, flush=True)
            last_line = line
        if backlight_on():
            # wake just after the next minute boundary
            delay = 60.0 - (time.time() % 60.0) + 0.25
        else:
            # dark: block until the SIGUSR1 wake (call-watcher lights the
            # screen on a ring, phone-screen-toggle on screen-on)
            delay = None
        if select.select([r], [], [], delay)[0]:
            try:
                os.read(r, 4096)  # drain wake bytes
            except OSError:
                pass


def main():
    w, _h = map(int, open(f"{SYSFB}/virtual_size").read().split(","))
    stride = int(open(f"{SYSFB}/stride").read().strip())
    font = Font.load(BAR_FONT)

    # Wake pipe: SIGUSR1 from phone-screen-toggle (screen back on) drops a
    # byte here via set_wakeup_fd, which interrupts the select() below so
    # the bar repaints the moment the screen lights up.
    r, wfd = os.pipe()
    os.set_blocking(wfd, False)
    signal.set_wakeup_fd(wfd)

    signal.signal(signal.SIGUSR1, _noop)

    net = (None, None)
    net_age = 0.0        # when the cached mmcli result was fetched
    last_minute = -1     # wall-clock minute last painted
    last_band = None     # (left, right) last painted, to skip no-op writes
    with open(FB, "r+b", buffering=0) as fb:
        while True:
            now = time.time()
            # one repaint per wall-clock minute: the clock is the
            # fastest-changing value on the bar, so nothing is gained by
            # painting more often (and each paint is a CPU wake)
            if backlight_on() and int(now // 60) != last_minute:
                try:
                    if now - net_age >= MODEM_EVERY:
                        net = read_modem()   # wakes ModemManager: cache it
                        net_age = now
                    left, lrgb, right, rrgb = status_parts(net)

                    band = (left, right)
                    if band != last_band:
                        buf = build_band(font, w, left, lrgb, right, rrgb)
                        paint(fb, buf, stride, w)
                        last_band = band
                except Exception as e:
                    print(f"statusbar: {e}", flush=True)
                # count failed attempts too, so errors don't spam the log
                last_minute = int(now // 60)
            if backlight_on():
                # wake just after the next minute boundary
                delay = 60.0 - (time.time() % 60.0) + 0.25
            else:
                # dark: block until the SIGUSR1 wake (the only writer of
                # the backlight pokes us when it lights the screen again)
                delay = None
            if select.select([r], [], [], delay)[0]:
                try:
                    os.read(r, 4096)  # drain wake bytes
                except OSError:
                    pass
                # poked (screen on): repaint right away, even mid-minute
                last_minute = -1
                last_band = None


if __name__ == "__main__":
    if "--text" in sys.argv:
        text_mode()
    else:
        main()
