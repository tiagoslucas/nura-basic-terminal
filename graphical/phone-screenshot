#!/bin/sh
# phone-screenshot — capture the graphical (sway) session with grim to
# ~tiagol/Pictures/screenshot-<timestamp>.png. Vol-up held + power click
# runs this via phone-screen-toggle; can also be run directly as root.
# No-op when no graphical session is up (console capture would need
# fbgrab, which is not installed).
pgrep -x sway >/dev/null || exit 0
sock=$(ls -t /run/user/10000/wayland-* 2>/dev/null | head -1)
[ -S "$sock" ] || exit 0
mkdir -p /home/tiagol/Pictures
chown tiagol:tiagol /home/tiagol/Pictures
out=/home/tiagol/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png
sudo -u tiagol env \
    XDG_RUNTIME_DIR=/run/user/10000 \
    WAYLAND_DISPLAY="${sock##*/}" \
    grim "$out" && echo "phone-screenshot: $out"
