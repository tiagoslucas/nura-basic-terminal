#!/bin/sh
# Power button handler. Run as root by hkdm on KEY_POWER release.
#   double click (releases <450ms apart): toggle the on-screen keyboard
#                                          (stop/start buffyboard)
#   single click: toggle the screen on/off, after a short delay so a
#                 second click can still be recognized as a double click
# Screen off = backlight 0 + console blank (session on tty1 is untouched).
# Skips everything when volume-down is held (ttyescape combo uses
# vol-down + power; /tmp/ttyescape.tmp exists while vol-down is down).
STATE_DIR=/run/phone-buttons
BL=/sys/class/backlight/backlight
DOUBLECLICK_CS=45   # double-click window in centiseconds

mkdir -p "$STATE_DIR"

if [ "$1" = "--do-toggle" ]; then
    # Delayed single-click path (spawned by this script itself)
    if [ -f "$STATE_DIR/screen-off" ]; then
        rm -f "$STATE_DIR/screen-off"
        # wake the console first, then bring the light back
        setterm --blank poke > /dev/tty1 2>/dev/null
        if [ -s "$STATE_DIR/brightness" ]; then
            cat "$STATE_DIR/brightness" > "$BL/brightness"
        else
            echo 1500 > "$BL/brightness"
        fi
        # console repaint on unblank erases the keyboard: ask for a redraw
        pkill -USR1 buffyboard 2>/dev/null
        # nudge the status bar awake — it sleeps while the screen is dark
        systemctl kill -s SIGUSR1 phone-statusbar 2>/dev/null \
            || pkill -USR1 -f /usr/local/bin/phone-statusbar 2>/dev/null
    else
        cat "$BL/brightness" > "$STATE_DIR/brightness" 2>/dev/null
        touch "$STATE_DIR/screen-off"
        echo 0 > "$BL/brightness"
        setterm --blank force > /dev/tty1 2>/dev/null
    fi
    exit 0
fi

[ -f /tmp/ttyescape.tmp ] && exit 0

# --- double-click discrimination (timestamps from /proc/uptime, centis) ---
now_cs=$(awk '{printf "%d", $1*100}' /proc/uptime)
last_cs=$(cat "$STATE_DIR/power-last" 2>/dev/null || echo 0)
echo "$now_cs" > "$STATE_DIR/power-last"
# phone-font's ttyescape guard keys off this file's mtime
touch "$STATE_DIR/power-recent"

if [ $((now_cs - last_cs)) -ge 0 ] && [ $((now_cs - last_cs)) -lt $DOUBLECLICK_CS ]; then
    # Double click: toggle the keyboard. If the screen is off, let the
    # pending single-click wake proceed so the user isn't left in the dark;
    # if it's on, cancel the pending screen-off so only the keyboard moves.
    if [ ! -f "$STATE_DIR/screen-off" ]; then
        rm -f "$STATE_DIR/power-single-pending"
    fi
    if systemctl is-active --quiet buffyboard; then
        systemctl stop buffyboard    # reset_all() restores full console rows
    else
        systemctl start buffyboard   # shrink_current() on start
    fi
    exit 0
fi

# --- single click (so far): arm and delay the screen toggle ---
token="$now_cs"
echo "$token" > "$STATE_DIR/power-single-pending"
(
    sleep 0.45
    [ "$(cat "$STATE_DIR/power-single-pending" 2>/dev/null)" = "$token" ] || exit 0
    rm -f "$STATE_DIR/power-single-pending"
    exec /usr/local/bin/phone-screen-toggle --do-toggle
) &
exit 0
